<Window x:Class="TiviWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Tivi"
        Background="Black"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
  <Window.Resources>
    <!-- Nút chế độ (TV / YouTube): màu nền do code đặt (xanh dương, đỏ, trắng) nên dùng khuôn riêng để hover/nhấn không ghi đè màu -->
    <Style x:Key="ModeButton" TargetType="Button">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#1A1A1A" />
      <Setter Property="BorderBrush" Value="#B5B5B5" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#1A1A1A" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.8" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <DockPanel>
    <!-- Thanh dưới: TV, YouTube, ← (khi xem kênh), trạng thái, đồng hồ + âm lịch.
         Đặt mọi nút ở đây vì WebView2 là cửa sổ riêng, WPF không vẽ đè lên được. -->
    <Border DockPanel.Dock="Bottom" Height="40" Background="White">
      <DockPanel Margin="4,3">
        <TextBlock x:Name="ClockText" DockPanel.Dock="Right" Margin="12,0"
                   VerticalAlignment="Center" FontWeight="Bold" Foreground="#1A1A1A" />
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
          <Button x:Name="BtnTv" Content="TV" Width="110" Height="32" Margin="0,0,4,0"
                  Style="{StaticResource ModeButton}" FontWeight="Bold" Click="BtnTv_Click" />
          <Button x:Name="BtnYt" Content="YouTube" Width="110" Height="32" Margin="0,0,4,0"
                  Style="{StaticResource ModeButton}" FontWeight="Bold" Click="BtnYt_Click" />
          <Button x:Name="BtnBack" Content="←" Width="48" Height="32" Margin="0,0,4,0"
                  FontSize="16" FontWeight="Bold" Visibility="Collapsed" Click="BtnBack_Click" />
        </StackPanel>
        <TextBlock x:Name="VoiceStatus" Visibility="Collapsed" Foreground="#1A1A1A"
                   Margin="12,0" VerticalAlignment="Center" FontSize="14"
                   TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <Grid>
      <!-- YouTube -->
      <wv2:WebView2 x:Name="Web" DefaultBackgroundColor="Black" />

      <!-- TV: trang chọn đài / chọn kênh -->
      <Grid x:Name="Chooser" Background="#0E0E14" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="ChooserTitle" Text="Chọn Kênh" Foreground="White"
                   FontSize="20" FontWeight="Bold" Margin="12,10" />
        <ScrollViewer x:Name="ChooserScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" />
      </Grid>

      <!-- TV: trang phát kênh (ẩn trong lúc đếm ngược 5-4-3-2-1) -->
      <wv2:WebView2 x:Name="Player" DefaultBackgroundColor="Black" Visibility="Collapsed" />

      <!-- Đếm ngược 5-4-3-2-1 che lúc kênh đang tải -->
      <Border x:Name="CoverBorder" Background="Black" Visibility="Collapsed">
        <TextBlock x:Name="CoverText" Text="5" Foreground="White" FontSize="96" FontWeight="Bold"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>

      <!-- Kênh điều khiển từ điện thoại (1x1, ẩn, giống WebView 1x1 bên Android) -->
      <wv2:WebView2 x:Name="RemoteHost" Width="1" Height="1"
                    HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" />
    </Grid>
  </DockPanel>
</Window>
