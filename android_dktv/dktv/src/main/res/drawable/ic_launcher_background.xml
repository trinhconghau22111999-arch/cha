        android:strokeColor="#1A00E5FF"
        android:strokeWidth="0.5"
        android:pathData="M0,18H108M0,36H108M0,54H108M0,72H108M0,90H108M18,0V108M36,0V108M54,0V108M72,0V108M90,0V108" />

    <!-- Hai vet sang cheo -->
    <path
        android:strokeColor="#88FF2D95"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:pathData="M-4,96L112,58" />
    <path
        android:strokeColor="#5500E5FF"
        android:strokeWidth="0.8"
        android:strokeLineCap="round"
        android:pathData="M-4,102L112,64" />
