<?xml version="1.0" encoding="utf-8"?>
<!--
    Nen icon Gaming: gradient den xanh -> tim dam, luoi ke o cyan mo, vet sang cheo hong/cyan, quang sang cyan o giua.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0" android:color="#FF0A0C12" />
                <item android:offset="0.6" android:color="#FF150F33" />
                <item android:offset="1" android:color="#FF2D0F52" />
