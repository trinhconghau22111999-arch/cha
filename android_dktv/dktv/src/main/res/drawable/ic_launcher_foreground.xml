<?xml version="1.0" encoding="utf-8"?>
<!--
    Icon Gaming: tay cam choi game vat goc, vien neon gradient cyan -> hong co vang sang, D-pad cyan ben trai,
    4 nut mau (hong / vang / cyan / xanh la) ben phai. Nam trong vung an toan 66dp cua Adaptive Icon.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
